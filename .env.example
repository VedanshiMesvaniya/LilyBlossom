# Supabase (frontend + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role. Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Metadata enrichment
TMDB_API_KEY=

# Shared secret the scheduler/admin uses to call the crawler endpoint.
CRAWLER_SECRET=

# Direct Postgres connection, used by the Python crawler worker.
DATABASE_URL=

# Support contact shown in the footer and About page.
SUPPORT_EMAIL=support@gltracker.app
