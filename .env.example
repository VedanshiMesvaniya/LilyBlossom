# One shared file for both halves of the app. The React frontend
# (Vite) only ever reads keys that start with VITE_, so the backend
# keys below never reach the browser bundle even though they live in
# the same file. Copy this file to .env and fill in real values.

# Supabase project URL and public (anon) key. Both the frontend and
# the Python backend read these two.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role. Backend only. Never rename this to start
# with VITE_, that would expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Metadata enrichment, used by the crawler.
TMDB_API_KEY=

# Shared secret the daily scheduler and the admin dashboard use to
# call the crawler backend's /run endpoint.
CRAWLER_SECRET=

# Direct Postgres connection, used by the Python crawler pipeline.
DATABASE_URL=

# Local URL of the Python backend (crawler/worker.py). The frontend
# calls this for admin actions and the crawler trigger button.
VITE_API_URL=http://localhost:8787

# Port the Python backend listens on locally. Must match the port
# in VITE_API_URL above.
CRAWLER_WORKER_PORT=8787

# Support contact shown in the footer.
VITE_SUPPORT_EMAIL=vedanshimesvaniya@gmail.com

# "development" (default) lets the backend fall back to a permissive
# CORS origin. Set to "production" on a real deployment; the backend
# then refuses to start unless FRONTEND_ORIGIN below is also set to a
# real URL, see docs/DEPLOYMENT.md.
ENVIRONMENT=development

# Exact URL of the deployed frontend, for the backend's CORS policy.
# Leave unset for local development (defaults to "*").
FRONTEND_ORIGIN=

# Upper bound on TMDB /discover pages fetched per type, per crawl run.
MAX_TMDB_PAGES=10

# Upper bound on AniList pages fetched per crawl run.
MAX_ANILIST_PAGES=20

# Countries of origin AniList is asked about, one query each, so every
# region gets its own pages. Comma separated ISO codes. Leave blank for
# the built in list.
ANILIST_COUNTRIES=

# Regions TMDB is asked about (with_origin_country), one pass each, on top
# of one pass with no region filter. Comma separated ISO codes. Leave
# blank for the built in list of about 50 regions.
TMDB_REGIONS=

# Minimum AniList "Yuri" tag rank, 0 to 100. Higher means only titles
# where yuri is a strong theme. AniList's own default is 18.
ANILIST_MIN_TAG_RANK=30

# Upper bound on GL Archive catalog pages followed per crawl run.
MAX_GL_ARCHIVE_PAGES=20

# Upper bound on MyAnimeList (Jikan) pages fetched per crawl run.
MAX_JIKAN_PAGES=10
