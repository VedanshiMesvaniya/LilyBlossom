{
  "name": "lilyblossom",
  "version": "0.1.0",
  "private": true,
  "description": "LilyBlossom: a dedicated Girls' Love (GL/yuri) media catalog and personal watch tracker.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,magenta \"vite\" \"python3 crawler/worker.py\"",
    "dev:web": "vite",
    "dev:api": "python3 crawler/worker.py",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
